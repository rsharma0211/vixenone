# VixenOne Root Environment Variables (Local Development Defaults)

# Project
PROJECT_ID=demo-vixenone
ENV=development

# Web / Frontend
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:8000
VITE_FIREBASE_PROJECT_ID=demo-vixenone
VITE_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=


# API / Backend
API_PORT=8000
CORS_ORIGINS=http://localhost:5173
FIREBASE_AUTH_EMULATOR_HOST=firebase-auth-emulator:9099
STORAGE_BACKEND=local
UPLOAD_DIR=/app/uploads

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=vixenone
POSTGRES_PASSWORD=vixenone
POSTGRES_DB=vixenone
DATABASE_URL=postgresql+psycopg://vixenone:vixenone@postgres:5432/vixenone

# Firebase Auth Emulator
FIREBASE_EMULATOR_UI_PORT=4000
FIREBASE_AUTH_PORT=9099
FIREBASE_EMULATOR_HUB_PORT=4400

# AI / Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
